# Local development only. Copy to .env and replace DJANGO_SECRET_KEY.
# Never commit .env. Production and staging must use different secrets and databases.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_LOG_LEVEL=INFO
DJANGO_JSON_LOGS=false

# Host ports avoid the workstation's existing PostgreSQL (5432),
# Avestellar PostGIS (5433), and Redis (6379, 6380).
DATABASE_URL=postgres://glitters:glitters-dev-only@127.0.0.1:5434/glitters
DATABASE_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6381/0
CELERY_BROKER_URL=redis://127.0.0.1:6381/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6381/2

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Media bytes use a private Cloudflare R2 bucket in staging and production.
# Development and the test suite use the in-memory adapter and need no credentials.
MEDIA_STORAGE_BACKEND=memory
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=glitters-media
# R2_REGION=auto
# MEDIA_UPLOAD_PUT_SECONDS=600
# MEDIA_UPLOAD_GET_SECONDS=120
# MEDIA_UPLOAD_SESSION_SECONDS=900
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_DOCUMENT_BYTES=20971520
